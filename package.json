{
  "name": "mert-fbo-naplo",
  "private": true,
  "description": "MERT FBŐ szolgálati naplók – webalkalmazás (PWA + API)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.2.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @fbo/api dev",
    "dev:web": "pnpm --filter @fbo/web dev",
    "db:generate": "pnpm --filter @fbo/api db:generate",
    "db:migrate": "pnpm --filter @fbo/api db:migrate",
    "bundle:cpanel": "pnpm build && node scripts/bundle-cpanel.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
