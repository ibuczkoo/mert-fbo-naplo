# Minta a környezeti változókhoz. Másold .env néven, vagy a cPanel
# "Setup Node.js App" felületén add meg őket egyenként.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# MariaDB a cPanel-tárhelyen (MySQL Databases menü)
DATABASE_URL=mysql://felhasznalo:jelszo@localhost:3306/adatbazis

# Aláírások, PDF-ek, csatolmányok helye (a webgyökéren KÍVÜL)
STORAGE_DIR=/home/FELHASZNALO/fbo-storage

# A lefordított webes felület (apps/web/dist)
WEB_DIST_DIR=/home/FELHASZNALO/fbo-app/apps/web/dist

# Munkamenet hossza órában (offline munkához ennyi ideig érvényes)
SESSION_HOURS=12

# LiteSpeed / Cloudflare mögött a valódi kliens-IP miatt
TRUST_PROXY=true
